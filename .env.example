# Optional GitHub API token for higher public API rate limits
GITHUB_TOKEN=

# Optional BharatCode AI integration
BHARATCODE_API_KEY=
BHARATCODE_BASE_URL=https://bharatcode.ai/api/model/v1
BHARATCODE_MODEL=qwen-3.8-27b

# Optional: header your own proxy/CDN always sets to the real client IP
# (e.g. cf-connecting-ip). Used for per-client rate limiting. Leave empty if unsure.
TRUSTED_IP_HEADER=
